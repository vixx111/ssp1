<Window x:Class="WmiNetworkProtocols.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сетевые протоколы (Win32_NetworkProtocol)" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
            <Button x:Name="BtnRefresh" Content="Обновить список" 
                    Width="150" Height="32" Click="BtnRefresh_Click" />
            <TextBlock x:Name="TxtCount" VerticalAlignment="Center" 
                       Margin="15,0,0,0" FontSize="13" Foreground="#444"/>
        </StackPanel>

        <DataGrid x:Name="DgProtocols" Grid.Row="1" AutoGenerateColumns="False" 
                  IsReadOnly="True" CanUserAddRows="False" 
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название протокола" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridCheckBoxColumn Header="Активен (Включен)" Binding="{Binding IsEnabled}" Width="130"/>
                <DataGridCheckBoxColumn Header="Поддержка Connect" Binding="{Binding SupportsConnectionlessService}" Width="140"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="2" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="Готово" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>